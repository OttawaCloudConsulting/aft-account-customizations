# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock files (uncomment if you want to commit lock files)
# .terraform.lock.hcl

# Ignore plan output files
*.tfplan

# Ignore any generated .jinja files (keeping templates)
# Uncomment if generated files should be ignored
# **/*.tf.jinja

# AFT-rendered output of locals-aft.tf.jinja — generated at AFT pipeline time
# from the .jinja template. Also generated locally as a stub so pre-commit
# terraform_validate and `terraform test` can resolve local.aft_management_account_id
# without the full pipeline render. Never commit.
baseline/terraform/locals-aft.tf
baseline/terraform/backend.tf
baseline/terraform/aft-providers.tf

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/
.classpath

# Python (for api_helpers)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
*.egg-info/
.pytest_cache/

# Logs
*.log

# Temporary files
*.tmp
*.temp
.*.tmp

# AI working files
agents/
.claude
memory/
**/red-team/**